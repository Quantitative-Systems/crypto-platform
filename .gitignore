.pytest_cache/
.tox/
.coverage
htmlcov/
pytestdebug.log
.mypy_cache/
.ruff_cache/

# IDE & OS Junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.tmp

# Local Databases & Process Logs
*.db
*.sqlite3
logs/
