# Python Bytecode & Compilation Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so

# Environments & Dependencies
.env
.env.*
.venv/
venv/
ENV/
env/
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
.pytest_cache/
.tox/
.coverage
htmlcov/
pytestdebug.log
.mypy_cache/
.ruff_cache/

# IDE & OS Junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.tmp

# Local Databases & Process Logs
*.db
*.db-*
**/*.db*
*.sqlite3
logs/
*.log

# Secrets, credentials & private keys (never commit)
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
credentials*
secrets*
*credential*.json
*secret*.json
*.env.local
*.env.production
*.env.staging
dist/
build/
node_modules/
*.pid

# Ephemeral Large Raw Data (Preserves manifests and small samples)
market_data/cache/*.json
data/
datasets/
research/results/BASELINE_002_*/
research/results/EXP_H1_1_*/

# Large temporary scratch runs (Preserves authoritative JSON reports)
scratch/*.tmp
scratch/temp_*
scratch/dataset_manifests.json
production/*state*.json
research/results/*state*.json
research/results/telemetry/*.jsonl
nohup.out

# Runtime scratch area: experiment/platform tools may write here at runtime.
# Curated evidence belongs in proofs/ or hypotheses/.../tests/; scratch output is not committed.
scratch/
*.db
