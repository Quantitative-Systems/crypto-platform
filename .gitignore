# Ephemeral Large Raw Data (Preserves manifests and small samples)
market_data/cache/*.json
data/
datasets/
research/results/BASELINE_002_*/
research/results/EXP_H1_1_*/

# Large temporary scratch runs (Preserves authoritative JSON reports)
scratch/*.tmp
scratch/temp_*
