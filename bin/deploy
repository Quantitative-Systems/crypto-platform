#!/usr/bin/env python3
"""bin/deploy — deployment gate (BLOCKED by default; requires qualification).

A strategy may only be deployed after passing the full chain:
DEV -> forensic review -> VAL -> OOS -> production/qualification gate.
This wrapper refuses to deploy anything unless the named strategy has a
qualification record under production/qualification evidence and an
approved manifest in deployed_strategies/.
"""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

def main() -> int:
    args = sys.argv[1:]
    if not args:
        print("usage: bin/deploy <strategy-id>")
        return 2
    sid = args[0]
    vault = ROOT / "deployed_strategies" / sid
    if not vault.exists():
        print(f"REFUSED: '{sid}' has no qualification record in "
              "deployed_strategies/. A Development/Validation result "
              "never qualifies a strategy for capital.")
        return 1
    print(f"'{sid}' vault entry found — deployment requires explicit "
          "operator approval per deployed_strategies/README.md.")
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
