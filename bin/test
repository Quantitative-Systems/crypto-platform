#!/usr/bin/env python3
"""bin/test — run the shared test suite (optionally a subset path).

Usage: bin/test [pytest args...]   (default: full collectible suite)
"""
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

def main() -> int:
    args = sys.argv[1:] or ["-q"]
    r = subprocess.run([sys.executable, "-m", "pytest", *args],
                       cwd=ROOT, check=False)
    return r.returncode

if __name__ == "__main__":
    raise SystemExit(main())
