# ==============================================================================
# Crypto Platform — Cloud Staging Environment Configuration Template
# ==============================================================================
# STAGING INVARIANT: STRICT PAPER / TESTNET EXECUTION ONLY
# REAL CAPITAL AUTHORIZED IS PERMANENTLY $0.00 (FAIL-CLOSED)
# ==============================================================================

# 1. Execution Environment & Safety Gate
PLATFORM_ENV=STAGING
PLATFORM_MODE=PAPER
PLATFORM_LIVE_CAPITAL_USD=0.0
LIVE_TRADING_ENABLED=false
PLATFORM_LOG_LEVEL=INFO

# 2. Network Binding & Host Configuration
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost,*.onrender.com,*.railway.app,*.fly.dev,*.vercel.app
CORS_ORIGINS=*

# 3. Cloud Staging API URL
STAGING_API_URL=https://crypto-platform-staging.onrender.com

# 4. Exchange Testnet Credentials (PAPER / FORWARD TESTNET ONLY)
# No real capital or mainnet accounts are permitted
BINANCE_TESTNET_API_KEY=testnet_api_key_placeholder
BINANCE_TESTNET_API_SECRET=testnet_api_secret_placeholder
BYBIT_TESTNET_API_KEY=testnet_api_key_placeholder
BYBIT_TESTNET_API_SECRET=testnet_api_secret_placeholder

# 5. Safety Invariants (Enforced by Frozen Research Contract)
MINIMUM_TARGET_FLOOR_R=4.0
MAX_TRADE_RISK_PERCENT=1.0
MAX_PORTFOLIO_HEAT_PERCENT=3.0

# 6. Persistence & State Directories
CHECKPOINT_DIR=/app/research/results
MARKET_DATA_CACHE_DIR=/app/market_data/cache
STATE_PERSISTENCE_BACKEND=SQLITE_WAL
