#!/usr/bin/env python3
"""bin/research — research laboratory operations (status only by default).

Research EXECUTION is governed: new strategy research requires an
authorized hypothesis lifecycle action via hypotheses.governance.
This tool never auto-promotes candidates (DEV != winner).
"""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

def main() -> int:
    from hypotheses.index_gen import generate_indexes
    from hypotheses.verify_lab import verify_lab
    generate_indexes()
    errs = verify_lab()
    print("research lab: indexes regenerated, "
          f"verifier {'CLEAN' if not errs else errs}")
    return 1 if errs else 0

if __name__ == "__main__":
    raise SystemExit(main())
