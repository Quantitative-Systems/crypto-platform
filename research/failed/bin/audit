#!/usr/bin/env python3
"""bin/audit — repository audit: orphan/orphan-state checks + summary."""
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

def main() -> int:
    rc = 0
    print("== Repository Audit ==")
    # uncommitted state
    r = subprocess.run(["git", "status", "--short"], cwd=ROOT,
                       capture_output=True, text=True, check=False)
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    print(f"git working tree: {'CLEAN' if not lines else f'{len(lines)} changes'}")
    # stray qcp references
    r2 = subprocess.run(
        ["grep", "-rl", "import qcp", "--include=*.py",
         "--exclude-dir=__pycache__", "--exclude-dir=archive", "."],
        cwd=ROOT, capture_output=True, text=True, check=False)
    hits = [l for l in r2.stdout.splitlines() if l.strip()]
    print(f"stale 'import qcp' refs: {hits or 'NONE'}")
    if hits:
        rc = 1
    # loose root test/debug scripts
    strays = [p.name for p in ROOT.glob("*.py")]
    print(f"loose root .py files: {strays or 'NONE'}")
    return rc

if __name__ == "__main__":
    raise SystemExit(main())
