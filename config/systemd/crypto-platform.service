[Unit]
Description=Institutional Crypto Trading Platform — Production Execution Engine
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mrcn2
WorkingDirectory=/home/mrcn2/crypto-platform
Environment=PYTHONUNBUFFERED=1
Environment=PLATFORM_ENV=PAPER
Environment=PLATFORM_LIVE_CAPITAL_USD=0.0
Environment=PLATFORM_LOG_LEVEL=INFO
EnvironmentFile=-/home/mrcn2/crypto-platform/.env
ExecStart=/usr/bin/python3 -m crypto_platform.cli service --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

# Hard security sandboxing
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/mrcn2/crypto-platform/research /home/mrcn2/crypto-platform/market_data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
