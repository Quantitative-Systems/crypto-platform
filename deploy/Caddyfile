# STRATA Digital Trading Platform — Caddyfile Configuration
# Automatic TLS Reverse Proxy with WebSocket & Streaming Buffer Bypass

{
    admin off
    auto_https off # Set to 'on' or provide domain for production Let's Encrypt certificates
}

:80 {
    # Logging
    log {
        output stdout
        format console
        level INFO
    }

    # Security Headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:;"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Reverse Proxy to STRATA application
    reverse_proxy strata-platform:8080 {
        # WebSocket support
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
        header_up Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.scheme}

        # Flush streaming responses immediately
        flush_interval -1
    }
}
