# ==============================================================================
# Crypto Engine — Environment Configuration Template
# ==============================================================================
# NEVER COMMIT REAL SECRETS, PRIVATE KEYS, OR API CREDENTIALS TO VERSION CONTROL
# Copy this file to .env and configure for your target environment:
#   cp .env.example .env
# ==============================================================================

# 1. Execution Environment Classification
# Supported Tiers: DEVELOPMENT | TEST | PAPER | DEMO | TESTNET | LIVE
# SAFETY INVARIANT: LIVE mode fails closed unless unlocked by cryptographic tokens.
PLATFORM_ENV=PAPER
PLATFORM_LIVE_CAPITAL_USD=0.0
PLATFORM_LOG_LEVEL=INFO

# 2. Network & Server Binding
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1

# 3. Exchange Sandbox / Testnet Credentials (DEMO / TESTNET TIERS ONLY)
# Binance USDT-M Futures Testnet: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret_here

# Bybit USDT Perpetual Testnet: https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=your_bybit_testnet_api_key_here
BYBIT_TESTNET_API_SECRET=your_bybit_testnet_api_secret_here

# MetaTrader 5 Terminal Gateway (Demo IPC)
MT5_SERVER=MetaQuotes-Demo
MT5_LOGIN=0
MT5_PASSWORD=demo_password_here

# 4. Exchange Production Credentials (LIVE TIER ONLY - CURRENTLY LOCKED AT $0.00)
# CRITICAL: API keys MUST NOT have withdrawal permissions enabled.
# The startup validator will immediately abort if withdrawal permissions are detected.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=

# 5. Cryptographic Safety Gate (Multi-Party Live Authorization Barrier)
# Required ONLY to unlock MICRO_LIVE or CONTROLLED_LIVE tiers.
PLATFORM_LIVE_AUTH_TOKEN=
PLATFORM_LIVE_GATE_SECRET=

# 6. Operational Notifications (Webhook / Telegram / Slack / Discord)
# Invariant: Credentials and secrets are automatically scrubbed before dispatch.
PLATFORM_ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# 7. Persistence & State Checkpointing
CHECKPOINT_DIR=research/results
CHECKPOINT_INTERVAL_SECONDS=60
STATE_PERSISTENCE_BACKEND=SQLITE_WAL
